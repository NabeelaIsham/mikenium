{
  "name": "mikenium-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "test": "npm test --prefix server",
    "test:integration": "npm run test:integration --prefix server",
    "check": "npm run check --prefix server && npm run check --prefix client",
    "release:check": "node scripts/release-check.js",
    "release:prepare": "node scripts/release-prepare.js",
    "security:check": "node scripts/security-check.js",
    "test:e2e": "npm run build && node server/scripts/run-integration.js --browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2"
  }
}
