{
  "name": "mikenium-api",
  "version": "1.0.0",
  "type": "module",
  "main": "src.js",
  "scripts": {
    "dev": "node --watch src.js",
    "start": "node src.js",
    "test": "node --test --test-concurrency=1",
    "test:integration": "node --test --test-concurrency=1 test/integration.test.js",
    "check": "node --check src.js && node --check app.js && node --test --test-concurrency=1",
    "db:init": "node scripts/init-db.js",
    "db:check": "node scripts/check-db.js",
    "smtp:check": "node scripts/check-smtp.js",
    "admin:create": "node scripts/create-super-admin.js",
    "mfa:generate": "node scripts/generate-mfa-secret.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.0",
    "zod": "^3.25.42"
  }
}
